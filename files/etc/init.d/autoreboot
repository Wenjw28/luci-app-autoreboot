#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

NAME=autoreboot
CRON=/etc/crontabs/root

read_cfg() {
	config_load autoreboot
	config_get_bool ENABLED main enabled 0
	config_get HOUR main hour 4
	config_get MIN main minute 0
	config_get WD main weekday '*'
	config_get DELAY main delay 10
}

sync_cron() {
	read_cfg
	sed -i "/# autoreboot/d" "$CRON" 2>/dev/null
	[ "$ENABLED" = "1" ] || return 0
	echo "$MIN $HOUR * * $WD sleep ${DELAY:-10} && /sbin/reboot # autoreboot" >> "$CRON"
	/etc/init.d/cron restart >/dev/null 2>&1
}

start_service() { sync_cron; }
reload_service() { sync_cron; }
service_triggers() { procd_add_reload_trigger autoreboot; }
stop_service() {
	sed -i "/# autoreboot/d" "$CRON" 2>/dev/null
	/etc/init.d/cron restart >/dev/null 2>&1
}
